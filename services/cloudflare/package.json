{
  "name": "tapchat-cloudflare",
  "version": "0.1.15",
  "private": true,
  "type": "module",
  "scripts": {
    "types": "wrangler types worker-configuration.d.ts --config wrangler.jsonc --env-interface CloudflareBindings --include-runtime --no-strict-vars",
    "types:check": "wrangler types --config wrangler.jsonc --env-interface CloudflareBindings --include-runtime --no-strict-vars --check",
    "check": "npm run check:error-contract && npm run types:check && tsc --noEmit",
    "check:error-contract": "node ../../scripts/check-error-contract.mjs",
    "test": "tsx --test test/cloudflare.test.ts test/device-registry-v2.test.ts test/group-contract-parity.test.ts test/protocol-v2.test.ts",
    "test:integration": "tsx --test --test-force-exit test/*.integration.test.ts",
    "build:embedded": "node scripts/build-embedded-worker.mjs",
    "check:embedded": "node scripts/build-embedded-worker.mjs --check",
    "transport:runtime": "node scripts/transport-runtime.mjs",
    "deploy:cloudflare": "node scripts/deploy-cloudflare.mjs",
    "cleanup:cloudflare": "node scripts/cleanup-cloudflare.mjs"
  },
  "dependencies": {
    "@noble/curves": "^1.9.7"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "esbuild": "^0.27.4",
    "jsonc-parser": "^3.3.1",
    "miniflare": "^4.20260317.3",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3",
    "wrangler": "^4.110.0"
  }
}
