{
  "name": "tapchat-desktop",
  "version": "0.1.16",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check:error-contract && npm run check:tauri-errors && npm run check:error-presentation && npm run check:security && tsc && vite build && node scripts/check-bundle-size.mjs",
    "check:error-contract": "node ../../scripts/check-error-contract.mjs",
    "check:tauri-errors": "node ../../scripts/check-tauri-command-errors.mjs",
    "check:error-presentation": "node ../../scripts/check-desktop-error-presentation.mjs",
    "check:security": "node scripts/check-security-config.mjs",
    "preview": "vite preview",
    "tauri": "node ./scripts/with-strawberry-perl.mjs tauri",
    "tauri:dev": "node ./scripts/with-strawberry-perl.mjs tauri dev",
    "tauri:build": "node ./scripts/with-strawberry-perl.mjs tauri build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tauri-apps/plugin-notification": "^2.0.0",
    "@tauri-apps/plugin-process": "^2.0.0",
    "@tauri-apps/plugin-shell": "^2.0.0",
    "@tauri-apps/plugin-updater": "^2.0.0",
    "blurhash": "^2.0.5",
    "lucide-react": "^1.11.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.18.2",
    "tapchat-desktop": "file:",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.20",
    "fast-check": "4.7.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "4.1.5"
  }
}
